# Common predicates, UNION ALL, non-correlated EXISTS and DISTINCT counts.
query IIIII
SELECT 1 IN (1,NULL), 1 IN (2,NULL), 1 NOT IN (2,3), NOT 1 IN (1,2), NULL IN (NULL)
----
true
NULL
true
false
NULL

query IIII
SELECT 5 BETWEEN 1 AND 10, 5 NOT BETWEEN 1 AND 3, NULL BETWEEN 1 AND 3, 0 BETWEEN 1 AND NULL
